{
  "extends": "@sicap/tsconfig/react-library.json",
  "include": ["src/**/*.tsx", "src/**/*.d.ts", "src/**/*.ts"],
  "exclude": ["dist", "build", "node_modules"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@ui/*": ["./src/components/ui/*"],
      "@ui/lib*": ["./src/lib*"]
    }
  }
}
