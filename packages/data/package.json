{
  "name": "@sicap/data",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./auth": "./dist/auth/index.js",
    "./auth-client": "./dist/auth/client.js",
    "./db": "./dist/db/index.js",
    "./schema": "./dist/db/schema.js",
    ".": "./dist/index.js"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "biome lint ./src",
    "check-types": "tsc --noEmit",
    "fmt": "biome format --write ./src",
    "clean": "pnpm dlx rimraf node_modules .turbo .dist",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:up": "drizzle-kit up",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "devDependencies": {
    "@sicap/tsconfig": "workspace:*",
    "@types/node": "^24.3.0",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@libsql/client": "^0.15.11",
    "@t3-oss/env-nextjs": "^0.8.0",
    "better-auth": "^1.3.6",
    "drizzle-orm": "^0.44.4",
    "libsql": "^0.5.17",
    "next-axiom": "^1.9.2",
    "tsup": "^8.5.0",
    "zod": "^3.25.76"
  }
}
