{
  "name": "@sicap/api",
  "version": "0.1.0",
  "types": "./dist/index.d.mts",
  "main": "src/index.ts",
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "lint": "biome lint ./src",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "dev": "tsup --watch",
    "check-types": "tsc --noEmit",
    "fmt": "biome format --write ./src",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "pnpm dlx rimraf node_modules .turbo .dist"
  },
  "devDependencies": {
    "@sicap/tsconfig": "workspace:*",
    "@swc/core": "^1.13.1",
    "@types/node": "^20.8.8",
    "@types/ramda": "^0.29.7",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.10.0",
    "dayjs": "^1.11.10",
    "ramda": "^0.29.1"
  }
}
