{
  "name": "@sicap/api",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./utils/date": {
      "types": "./src/utils/date.ts",
      "import": "./src/utils/date.ts"
    },
    "./types": {
      "types": "./src/es/types.ts",
      "import": "./src/es/types.ts"
    },
    "./es/utils": {
      "types": "./src/es/utils.ts",
      "import": "./src/es/utils.ts"
    },
    "./browser/constants": {
      "types": "./src/browser/constants.ts",
      "import": "./src/browser/constants.ts"
    }
  },
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "biome lint ./src",
    "check-types": "tsc --noEmit",
    "fmt": "biome format --write ./src",
    "clean": "pnpm dlx rimraf node_modules .turbo .dist"
  },
  "devDependencies": {
    "@sicap/tsconfig": "workspace:*",
    "@swc/core": "^1.13.1",
    "@types/node": "^20.8.8",
    "@types/ramda": "^0.29.7",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.10.0",
    "dayjs": "^1.11.10",
    "ramda": "^0.29.1"
  }
}
